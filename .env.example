# Copy to .env and fill in. All three tiers are free — you need at least one,
# but configure all three so the router can fail over on 429s.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time. That is
# fine for local development, but a shipped bundle is readable: for a real
# release, leave these blank and enter the keys in the app's Settings tab, where
# they are stored in the device keychain (expo-secure-store) instead.

# https://aistudio.google.com/apikey  (Gemini 2.5 Flash-Lite — primary)
EXPO_PUBLIC_GEMINI_API_KEY=

# https://console.groq.com/keys  (Llama 3.3 70B — first fallback)
EXPO_PUBLIC_GROQ_API_KEY=

# https://openrouter.ai/keys  (DeepSeek / Qwen :free models — final fallback)
EXPO_PUBLIC_OPENROUTER_API_KEY=
